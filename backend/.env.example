# Copia in .env e personalizza (non committare .env)
NODE_ENV=development
PORT=5000

# Obbligatorio in produzione — stringa lunga casuale
SESSION_SECRET=change-me-to-a-long-random-string

# Origine frontend per CORS + cookie di sessione
CORS_ORIGIN=http://localhost:3000

# Rate limit API titoli (richieste per IP per minuto)
STOCK_RATE_LIMIT_MAX=30

# Rate limit autenticazione (richieste per IP per minuto)
LOGIN_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_MAX=5
EMAIL_CHECK_RATE_LIMIT_MAX=20
